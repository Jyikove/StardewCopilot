<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="keychain/**/*.cs" />
    <Compile Remove="knowledge/**/*.cs" />
    <Compile Remove="menu/**/*.cs" />
    <Compile Remove="screen/**/*.cs" />
    <Compile Remove="vision/**/*.cs" />
    <Compile Remove="ui/**/*.cs" />
    <Compile Include="../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../src/ChatSession.cs" Link="ChatSession.cs" />
  </ItemGroup>
</Project>
